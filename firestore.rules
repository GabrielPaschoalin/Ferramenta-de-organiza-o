rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem está autenticado lê e escreve.
    // Para travar no seu e-mail, troque a condição por:
    // request.auth != null && request.auth.token.email == 'seu@email.com'
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
